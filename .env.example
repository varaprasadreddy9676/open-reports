# Copy to .env (docker compose reads it automatically) -- see docs/CONFIGURATION.md for every option.

# --- Security ---------------------------------------------------------------
# Comma-separated API keys. REQUIRED for anything reachable from a network.
# Clients send:  x-api-key: <key>   or   Authorization: Bearer <key>
API_KEYS=

# --- Server -----------------------------------------------------------------
PORT=4000
DB_PATH=./data/reporting.sqlite        # templates + versions (SQLite). Docker: /data/reporting.sqlite

# --- Data sources -----------------------------------------------------------
# Databases: REPORT_SQL_<NAME>=<url>   -> connection id "<name>" (lower-case, _ -> -)
# REPORT_SQL_HMS=postgres://reporting_ro:password@db.internal:5432/hms
# REPORT_SQL_ERP=mysql://reporting_ro:password@erp.internal/erp

# Secrets usable inside REST datasets as {{secrets.NAME}} (never stored in reports)
# REPORT_SECRET_BILLING_TOKEN=abc123

# Only these hostnames may be called by REST datasets (strict mode; also the way to allow an internal API).
# Leave empty to allow any PUBLIC host (private/loopback/metadata addresses are always blocked in that mode).
# REPORT_REST_ALLOWED_HOSTS=api.hospital.internal,billing.example.com

# Directory the "json" dataset type may read files from (disabled when empty)
# JSON_DATA_ROOT=./data/json

# If linked images use private/internal HTTP hosts, list their hostnames here.
# When set, image URLs are limited to these hosts. Public URLs work without this setting.
# REPORT_IMAGE_ALLOWED_HOSTS=images.hospital.internal

# --- Extensions -------------------------------------------------------------
# Plugins to load at start (npm package names or ./paths)
# REPORT_PLUGINS=@reporting/plugin-clinic-pack

# Directory of example *.report.json files exposed at /api/v1/examples (used by the designer's AI + MCP)
# EXAMPLES_DIR=./examples

# --- MCP server (packages/mcp-server) ----------------------------------------
# REPORTS_API_URL=http://localhost:4000
# REPORTS_API_KEY=
