      "right": 16,
      "bottom": 18,
      "left": 16
    }
  },
  "variables": [
    {
      "id": "gross",
      "scope": "report",
      "expression": "sumBy(data.settlements, \"gross\")"
    },
    {
      "id": "fees",
      "scope": "report",
      "expression": "sumBy(data.settlements, \"fee\")"
    },
    {
      "id": "net",
      "scope": "report",
      "expression": "sumBy(data.settlements, \"net\")"
    }
  ],
