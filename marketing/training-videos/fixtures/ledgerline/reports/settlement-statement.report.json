  "sections": [
    {
      "type": "pageHeader",
      "children": [
        {
          "type": "row",
          "gap": 4,
          "alignItems": "center",
          "children": [
            {
              "type": "image",
              "binding": "data.merchant.logo",
              "width": 34,
              "height": 34,
              "fit": "contain",
              "alt": "Merchant logo"
            },
            {
              "type": "column",
              "width": "*",
              "children": [
                {
                  "type": "text",
                  "binding": "data.merchant.name",
                  "style": {
                    "fontSize": 14,
                    "fontWeight": "bold",
                    "color": "#0b1020"
                  }
                },
                {
                  "type": "text",
                  "expression": "data.merchant.address + \" · GSTIN \" + data.merchant.gstin",
                  "style": {
                    "fontSize": 7.5,
                    "color": "#5b6478"
                  }
                }
              ]
            },
            {
              "type": "text",
              "value": "SETTLEMENTS",
              "width": 150,
              "style": {
                "align": "right",
                "fontSize": 12,
                "fontWeight": "bold",
                "color": "#4d7c0f"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "line"
        }
      ]
    },
    {
      "type": "detail",
      "children": [
        {
          "type": "spacer",
          "height": 6
        },
        {
          "type": "row",
          "gap": 6,
          "children": [
            {
              "type": "column",
              "width": "*",
              "children": [
                {
                  "type": "text",
                  "value": "PERIOD",
                  "style": {
                    "fontSize": 6.5,
                    "fontWeight": "bold",
                    "color": "#7b8499"
                  }
                },
                {
                  "type": "text",
                  "binding": "data.merchant.period",
                  "style": {
                    "fontSize": 12,
                    "fontWeight": "bold"
                  }
                },
                {
                  "type": "text",
                  "expression": "\"Merchant \" + data.merchant.merchantId + \" · payout to \" + data.merchant.settlementAccount",
                  "style": {
                    "fontSize": 7.5,
                    "color": "#5b6478"
                  }
                }
              ]
            },
            {
              "type": "column",
              "width": 230,
              "children": [
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "Gross collected",
                      "width": "*"
                    },
                    {
                      "type": "text",
                      "expression": "formatCurrency(vars.gross)",
                      "width": 110,
                      "style": {
                        "align": "right"
                      }
                    }
                  ]
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "Processing fees",
                      "width": "*"
                    },
                    {
                      "type": "text",
                      "expression": "formatCurrency(vars.fees)",
                      "width": 110,
                      "style": {
                        "align": "right"
                      }
                    }
                  ]
                },
                {
                  "type": "line"
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "Net payout",
                      "width": "*",
                      "style": {
                        "fontWeight": "bold"
                      }
                    },
                    {
                      "type": "text",
                      "expression": "formatCurrency(vars.net)",
                      "width": 110,
                      "style": {
                        "align": "right",
                        "fontWeight": "bold"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "table",
          "id": "settlements",
          "dataset": "settlements",
          "showFooter": true,
          "alternateRowStyle": true,
          "repeatHeader": true,
          "columns": [
            {
              "id": "date",
              "header": "Date",
              "expression": "formatDate(row.date, \"dd MMM\")",
              "width": 60
            },
            {
              "id": "reference",
              "header": "Reference",
              "binding": "row.reference",
              "width": "*"
            },
            {
              "id": "method",
              "header": "Method",
              "binding": "row.method",
              "width": 60
            },
            {
              "id": "gross",
              "header": "Gross",
              "binding": "row.gross",
              "format": "currency:INR",
              "width": 84,
              "align": "right",
              "footer": {
                "aggregate": "sum"
              }
            },
            {
              "id": "fee",
              "header": "Fee",
              "binding": "row.fee",
              "format": "currency:INR",
              "width": 70,
              "align": "right",
              "footer": {
                "aggregate": "sum"
              }
            },
            {
              "id": "net",
              "header": "Net",
              "binding": "row.net",
              "format": "currency:INR",
              "width": 84,
              "align": "right",
              "footer": {
                "aggregate": "sum"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "pageFooter",
      "children": [
        {
          "type": "line"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "value": "Ledgerline settlement statement · amounts in INR",
              "width": "*",
              "style": {
                "fontSize": 6.5,
                "color": "#5b6478"
              }
            },
            {
              "type": "text",
              "expression": "\"Page \" + page.number + \" of \" + page.total",
              "style": {
                "align": "right",
                "fontSize": 7,
                "color": "#5b6478"
              }
            }
          ]
        }
      ]
    }
  ]
}
