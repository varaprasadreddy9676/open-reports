{
  "name": "@reporting/datasource-rest",
  "version": "0.2.0",
  "description": "REST datasource: GET/POST with headers/query/body parameter interpolation, SSRF protection, timeouts and response size limits",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reporting/core": "workspace:*",
    "@reporting/schema": "workspace:*",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
