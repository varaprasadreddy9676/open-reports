{
  "name": "@reporting/renderer-docx",
  "version": "0.2.0",
  "description": "DOCX renderer: an editable Word document from a Resolved Report Tree, with real tables, headings, links and live page numbers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reporting/core": "workspace:*",
    "@reporting/layout": "workspace:*",
    "@reporting/schema": "workspace:*",
    "bwip-js": "^4.5.1",
    "docx": "^9.8.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "jszip": "^3.10.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
