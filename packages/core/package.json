{
  "name": "@reporting/core",
  "version": "0.2.0",
  "description": "Rendering pipeline core: validation, parameter/dataset resolution, expression evaluation, and the Resolved Report Tree that renderers consume",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reporting/schema": "workspace:*",
    "@reporting/expressions": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
