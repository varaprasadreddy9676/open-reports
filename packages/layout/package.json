{
  "name": "@reporting/layout",
  "version": "0.1.0",
  "description": "Pagination and box layout engine: turns a Resolved Report Tree into pages of positioned boxes (flow/row/column/grid/absolute), with repeated headers/footers, keep-together and real page numbers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reporting/schema": "workspace:*",
    "@reporting/expressions": "workspace:*",
    "@reporting/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
