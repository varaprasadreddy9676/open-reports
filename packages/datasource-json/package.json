{
  "name": "@reporting/datasource-json",
  "version": "0.2.0",
  "description": "JSON datasource: resolves a dataset from an embedded object/array, a local JSON file (sandboxed to an allowed root), or a JSON string",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reporting/schema": "workspace:*",
    "@reporting/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
