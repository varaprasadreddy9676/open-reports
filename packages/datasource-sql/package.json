{
  "name": "@reporting/datasource-sql",
  "version": "0.1.0",
  "description": "SQL datasource (PostgreSQL, MySQL): parameterized queries against named connections, never string-concatenated SQL, with row/timeout limits",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reporting/core": "workspace:*",
    "@reporting/schema": "workspace:*",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "pg-cursor": "^2.22.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
