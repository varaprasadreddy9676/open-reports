{
  "name": "reporting-platform",
  "private": true,
  "version": "0.2.0",
  "description": "Modern open-source reporting engine (monorepo root)",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build",
    "test": "pnpm -r --filter=./packages/** test",
    "test:unit": "pnpm -r --filter=./packages/** test",
    "lint": "pnpm -r --filter=./packages/** lint",
    "typecheck": "pnpm -r --filter=./packages/** typecheck",
    "build:all": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @reporting/server build && pnpm --filter @reporting/designer build",
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "examples": "node scripts/build-examples.mjs",
    "test:all": "pnpm -r test",
    "check:schema-consumers": "node scripts/schema-consumers.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "fontkit@1.9.0": "patches/fontkit@1.9.0.patch"
    }
  }
}
