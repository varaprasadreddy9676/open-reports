{
  "name": "reporting-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Modern open-source reporting engine (monorepo root)",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build",
    "test": "pnpm -r --filter=./packages/** test",
    "test:unit": "pnpm -r --filter=./packages/** test",
    "lint": "pnpm -r --filter=./packages/** lint",
    "typecheck": "pnpm -r --filter=./packages/** typecheck",
    "dev": "echo 'see apps/server and apps/designer'"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
