  "variables": [
    {
      "id": "credits",
      "scope": "report",
      "expression": "sumBy(data.account.transactions, \"credit\")"
    },
    {
      "id": "debits",
      "scope": "report",
      "expression": "sumBy(data.account.transactions, \"debit\")"
    }
  ],
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "unit": "mm",
    "margin": {
      "top": 15,
      "right": 15,
      "bottom": 18,
      "left": 15
    }
  },
  "sections": [
    {
      "type": "pageHeader",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "value": "ACCOUNT STATEMENT",
              "width": "*",
              "style": {
                "fontWeight": "bold",
                "fontSize": 14
              }
            },
            {
              "type": "text",
              "binding": "data.account.number",
              "style": {
                "align": "right"
              }
            }
          ]
        },
        {
          "type": "line"
        }
      ]
    },
    {
      "type": "detail",
      "children": [
        {
          "type": "spacer",
          "height": 6
        },
        {
          "type": "text",
          "expression": "data.account.holder + \"   |   \" + data.account.period",
          "style": {
            "fontSize": 9
          }
        },
        {
          "type": "text",
          "expression": "\"Total credits \" + formatCurrency(vars.credits) + \"    Total debits \" + formatCurrency(vars.debits)",
          "style": {
            "fontSize": 9,
            "color": "#6b7280"
          }
        },
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "table",
          "id": "transactions",
          "dataset": "account.transactions",
          "repeatHeaderOnPageBreak": true,
          "minRowsAfterBreak": 3,
          "style": {
            "fontSize": 8
          },
          "rowRules": [
            {
              "when": "row.balance < 30000",
              "set": {
                "style.color": "#b91c1c"
              }
            }
          ],
          "columns": [
            {
              "id": "date",
              "header": "Date",
              "binding": "row.date",
              "format": "date:dd/MM/yyyy",
              "width": 62
            },
            {
              "id": "narration",
              "header": "Narration",
              "binding": "row.narration",
              "width": "*"
            },
            {
              "id": "debit",
              "header": "Debit",
              "binding": "row.debit",
              "format": "number:2",
              "width": 70,
              "align": "right"
            },
            {
              "id": "credit",
              "header": "Credit",
              "binding": "row.credit",
              "format": "number:2",
              "width": 70,
              "align": "right"
            },
            {
              "id": "balance",
              "header": "Balance",
              "binding": "row.balance",
              "format": "number:2",
              "width": 80,
              "align": "right"
            }
          ]
        }
      ]
    },
    {
      "type": "pageFooter",
      "children": [
        {
          "type": "text",
          "expression": "\"Page \" + page.number + \" of \" + page.total",
          "style": {
            "align": "right",
            "fontSize": 8,
            "color": "#6b7280"
          }
        }
      ]
    }
  ]
