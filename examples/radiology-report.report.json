{
  "schemaVersion": "1.0",
  "id": "radiology-report",
  "name": "Radiology Report",
  "description": "Hospital letterhead with replaceable left and right logos, patient and study details, findings, and a branded footer. Replace the image sources and hospital details.",
  "locale": "en-IN",
  "datasets": [
    {
      "id": "study",
      "source": "inline",
      "query": {
        "data": {
          "patient": {
            "name": "Alex Morgan",
            "age": "31 Y",
            "sex": "Male",
            "uhid": "UH12345"
          },
          "exam": "X-ray chest PA view",
          "date": "2025-10-01",
          "radiologist": "Dr. R. Rao, MD Radiology",
          "sections": [
            {
              "heading": "Technique",
              "text": "Single frontal chest radiograph obtained in erect position at full inspiration."
            },
            {
              "heading": "Findings",
              "text": "Both lung fields are clear. No consolidation, effusion or pneumothorax. Cardiac silhouette is normal in size. Both costophrenic angles are sharp. Bony thorax and soft tissues are unremarkable."
            }
          ],
          "impression": "No acute cardiopulmonary abnormality."
        }
      }
    }
  ],
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "unit": "mm",
    "margin": {
      "top": 15,
      "right": 15,
      "bottom": 18,
      "left": 15
    }
  },
  "sections": [
    {
      "type": "pageHeader",
      "appliesTo": "first",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "image",
              "id": "hospital-left-logo",
              "src": "https://open-reports-demo.onrender.com/demo-videos/letterhead-assets/northstar-primary-logo.png",
              "width": 30,
              "height": 30,
              "fit": "contain",
              "alt": "Replaceable hospital logo"
            },
            {
              "type": "column",
              "children": [
                {
                  "type": "text",
                  "value": "NORTHSTAR MEDICAL CENTER",
                  "style": {
                    "fontSize": 15,
                    "fontWeight": "bold",
                    "color": "#143753"
                  }
                },
                {
                  "type": "text",
                  "value": "CARE WITH CLARITY · COMPASSION IN EVERY STEP",
                  "style": {
                    "fontSize": 6.5,
                    "fontWeight": "bold",
                    "color": "#167c80"
                  }
                },
                {
                  "type": "text",
                  "value": "123 Meridian Avenue · Bengaluru 560001 · +91 80 4567 8900",
                  "style": {
                    "fontSize": 6.5,
                    "color": "#526575"
                  }
                }
              ],
              "width": "*"
            },
            {
              "type": "image",
              "id": "hospital-right-seal",
              "src": "https://open-reports-demo.onrender.com/demo-videos/letterhead-assets/northstar-accreditation-mark.png",
              "width": 28,
              "height": 28,
              "fit": "contain",
              "alt": "Replaceable hospital accreditation seal"
            }
          ],
          "gap": 4,
          "alignItems": "center"
        },
        {
          "type": "line"
        },
        {
          "type": "text",
          "value": "RADIOLOGY REPORT",
          "style": {
            "fontSize": 8,
            "fontWeight": "bold",
            "color": "#526575"
          }
        }
      ]
    },
    {
      "type": "pageHeader",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "expression": "\"Patient: \" + data.study.patient.name + \" · UHID \" + data.study.patient.uhid",
              "width": "*",
              "style": {
                "fontSize": 7.5,
                "color": "#526575"
              }
            },
            {
              "type": "text",
              "value": "RADIOLOGY REPORT",
              "style": {
                "align": "right",
                "fontSize": 7.5,
                "fontWeight": "bold",
                "color": "#143753"
              }
            }
          ]
        },
        {
          "type": "line"
        }
      ]
    },
    {
      "type": "detail",
      "children": [
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "expression": "\"Patient: \" + data.study.patient.name + \" · \" + data.study.patient.age + \" / \" + data.study.patient.sex",
              "width": "*",
              "style": {
                "fontWeight": "bold"
              }
            },
            {
              "type": "text",
              "expression": "\"UHID: \" + data.study.patient.uhid"
            }
          ]
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "binding": "data.study.exam",
              "width": "*"
            },
            {
              "type": "text",
              "expression": "\"Date: \" + data.study.date",
              "style": {
                "align": "right"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "height": 10
        },
        {
          "type": "repeater",
          "id": "findings",
          "dataset": "study.sections",
          "children": [
            {
              "type": "keepTogether",
              "children": [
                {
                  "type": "text",
                  "binding": "row.heading",
                  "style": {
                    "fontWeight": "bold",
                    "fontSize": 11
                  },
                  "keepWithNext": true
                },
                {
                  "type": "text",
                  "binding": "row.text",
                  "minLinesAtTop": 2,
                  "minLinesAtBottom": 2
                },
                {
                  "type": "spacer",
                  "height": 6
                }
              ]
            }
          ]
        },
        {
          "type": "keepTogether",
          "children": [
            {
              "type": "text",
              "value": "Impression",
              "style": {
                "fontWeight": "bold",
                "fontSize": 11
              }
            },
            {
              "type": "text",
              "binding": "data.study.impression",
              "style": {
                "fontWeight": "bold"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "pageFooter",
      "children": [
        {
          "type": "line"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "binding": "data.study.radiologist",
              "width": "*",
              "style": {
                "fontSize": 7,
                "fontWeight": "bold",
                "color": "#526575"
              }
            },
            {
              "type": "text",
              "expression": "\"Page \" + page.number + \" of \" + page.total",
              "style": {
                "align": "right",
                "fontSize": 7,
                "color": "#526575"
              }
            }
          ]
        },
        {
          "type": "text",
          "value": "Confidential patient information · For care-team use",
          "style": {
            "fontSize": 6,
            "align": "center",
            "color": "#718096"
          }
        }
      ]
    }
  ]
}
