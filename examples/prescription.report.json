{
  "schemaVersion": "1.0",
  "id": "prescription",
  "name": "Prescription",
  "description": "Hospital letterhead with replaceable left and right logos, patient and medicine details, and a signature area. Replace the image sources and hospital details.",
  "locale": "en-IN",
  "datasets": [
    {
      "id": "rx",
      "source": "inline",
      "query": {
        "data": {
          "doctor": {
            "name": "Dr. A. Smith",
            "reg": "KMC 48213",
            "clinic": "ACME Health Clinic, Bengaluru"
          },
          "patient": {
            "name": "Alex Morgan",
            "age": "31",
            "sex": "Male",
            "uhid": "UH12345",
            "date": "2025-10-01"
          },
          "diagnosis": "Acute pharyngitis",
          "medicines": [
            {
              "name": "Amoxicillin 500 mg",
              "dose": "1-0-1",
              "days": 5,
              "notes": "After food"
            },
            {
              "name": "Paracetamol 650 mg",
              "dose": "SOS",
              "days": 3,
              "notes": "Max 3 per day"
            },
            {
              "name": "Saline gargle",
              "dose": "1-1-1",
              "days": 5,
              "notes": ""
            }
          ]
        }
      }
    }
  ],
  "page": {
    "size": "A5",
    "orientation": "portrait",
    "unit": "mm",
    "margin": {
      "top": 15,
      "right": 15,
      "bottom": 18,
      "left": 15
    }
  },
  "sections": [
    {
      "type": "pageHeader",
      "appliesTo": "first",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "image",
              "id": "hospital-left-logo",
              "src": "https://open-reports-demo.onrender.com/demo-videos/letterhead-assets/northstar-primary-logo.png",
              "width": 24,
              "height": 24,
              "fit": "contain",
              "alt": "Replaceable hospital logo"
            },
            {
              "type": "column",
              "children": [
                {
                  "type": "text",
                  "value": "NORTHSTAR MEDICAL CENTER",
                  "style": {
                    "fontSize": 10.5,
                    "fontWeight": "bold",
                    "color": "#143753"
                  }
                },
                {
                  "type": "text",
                  "value": "CARE WITH CLARITY · COMPASSION IN EVERY STEP",
                  "style": {
                    "fontSize": 5.5,
                    "fontWeight": "bold",
                    "color": "#167c80"
                  }
                },
                {
                  "type": "text",
                  "value": "123 Meridian Avenue · Bengaluru 560001 · +91 80 4567 8900",
                  "style": {
                    "fontSize": 5.5,
                    "color": "#526575"
                  }
                }
              ],
              "width": "*"
            },
            {
              "type": "image",
              "id": "hospital-right-seal",
              "src": "https://open-reports-demo.onrender.com/demo-videos/letterhead-assets/northstar-accreditation-mark.png",
              "width": 22,
              "height": 22,
              "fit": "contain",
              "alt": "Replaceable hospital accreditation seal"
            }
          ],
          "gap": 4,
          "alignItems": "center"
        },
        {
          "type": "line"
        },
        {
          "type": "text",
          "value": "PRESCRIPTION",
          "style": {
            "fontSize": 8,
            "fontWeight": "bold",
            "color": "#526575"
          }
        }
      ]
    },
    {
      "type": "pageHeader",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "expression": "\"Prescription · \" + data.rx.patient.name + \" · UHID \" + data.rx.patient.uhid",
              "width": "*",
              "style": {
                "fontSize": 7.5,
                "color": "#526575"
              }
            },
            {
              "type": "text",
              "value": "PRESCRIPTION",
              "style": {
                "align": "right",
                "fontSize": 7.5,
                "fontWeight": "bold",
                "color": "#143753"
              }
            }
          ]
        },
        {
          "type": "line"
        }
      ]
    },
    {
      "type": "detail",
      "children": [
        {
          "type": "spacer",
          "height": 6
        },
        {
          "type": "text",
          "expression": "data.rx.doctor.name + \" · \" + data.rx.doctor.reg + \" · \" + data.rx.doctor.clinic",
          "style": {
            "fontSize": 8,
            "color": "#6b7280"
          }
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "expression": "\"Patient: \" + data.rx.patient.name + \" (\" + data.rx.patient.age + \"/\" + data.rx.patient.sex + \")\"",
              "width": "*",
              "style": {
                "fontWeight": "bold"
              }
            },
            {
              "type": "text",
              "expression": "\"Date: \" + data.rx.patient.date",
              "style": {
                "align": "right"
              }
            }
          ]
        },
        {
          "type": "text",
          "expression": "\"Diagnosis: \" + data.rx.diagnosis",
          "style": {
            "fontSize": 9
          }
        },
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "text",
          "value": "Rx",
          "style": {
            "fontSize": 18,
            "fontWeight": "bold"
          }
        },
        {
          "type": "table",
          "id": "medicines",
          "dataset": "rx.medicines",
          "columns": [
            {
              "id": "name",
              "header": "Medicine",
              "binding": "row.name",
              "width": "*"
            },
            {
              "id": "dose",
              "header": "Dose",
              "binding": "row.dose",
              "width": 50
            },
            {
              "id": "days",
              "header": "Days",
              "binding": "row.days",
              "width": 36,
              "align": "right"
            },
            {
              "id": "notes",
              "header": "Notes",
              "binding": "row.notes",
              "width": 90
            }
          ]
        },
        {
          "type": "spacer",
          "height": 40
        },
        {
          "type": "keepTogether",
          "children": [
            {
              "type": "line"
            },
            {
              "type": "text",
              "value": "Doctor's signature",
              "style": {
                "fontSize": 8,
                "align": "right",
                "color": "#6b7280"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "pageFooter",
      "children": [
        {
          "type": "line"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "binding": "data.rx.doctor.name",
              "width": "*",
              "style": {
                "fontSize": 7,
                "color": "#526575"
              }
            },
            {
              "type": "text",
              "expression": "\"Page \" + page.number + \" of \" + page.total",
              "style": {
                "align": "right",
                "fontSize": 7,
                "color": "#526575"
              }
            }
          ]
        },
        {
          "type": "text",
          "value": "Confidential patient information · For care-team use",
          "style": {
            "fontSize": 6,
            "align": "center",
            "color": "#718096"
          }
        }
      ]
    }
  ]
}
