{
  "schemaVersion": "1.0",
  "id": "lab-report",
  "name": "Laboratory Report",
  "description": "Hospital letterhead with replaceable left and right logos, a results table, and a branded footer. Replace the image sources and hospital details to make it yours.",
  "locale": "en-IN",
  "datasets": [
    {
      "id": "report",
      "source": "inline",
      "query": {
        "data": {
          "patient": {
            "name": "Alex Morgan",
            "age": "31 Y",
            "sex": "Male",
            "uhid": "UH12345",
            "consultant": "Dr. Smith"
          },
          "collected": "2025-10-01 16:20",
          "test": "Complete Blood Count",
          "results": [
            {
              "parameter": "Haemoglobin",
              "value": 14.2,
              "unit": "g/dL",
              "low": 13,
              "high": 17
            },
            {
              "parameter": "WBC count",
              "value": 11.8,
              "unit": "10^3/uL",
              "low": 4,
              "high": 11
            },
            {
              "parameter": "Platelets",
              "value": 255,
              "unit": "10^3/uL",
              "low": 150,
              "high": 410
            },
            {
              "parameter": "Haematocrit",
              "value": 38,
              "unit": "%",
              "low": 40,
              "high": 50
            }
          ],
          "interpretation": "Mild leukocytosis and borderline low haematocrit. Clinical correlation advised."
        }
      }
    }
  ],
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "unit": "mm",
    "margin": {
      "top": 15,
      "right": 15,
      "bottom": 18,
      "left": 15
    }
  },
  "sections": [
    {
      "type": "pageHeader",
      "appliesTo": "first",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "image",
              "id": "hospital-left-logo",
              "src": "https://open-reports-demo.onrender.com/demo-videos/letterhead-assets/northstar-primary-logo.png",
              "width": 30,
              "height": 30,
              "fit": "contain",
              "alt": "Replaceable hospital logo"
            },
            {
              "type": "column",
              "children": [
                {
                  "type": "text",
                  "value": "NORTHSTAR MEDICAL CENTER",
                  "style": {
                    "fontSize": 15,
                    "fontWeight": "bold",
                    "color": "#143753"
                  }
                },
                {
                  "type": "text",
                  "value": "CARE WITH CLARITY · COMPASSION IN EVERY STEP",
                  "style": {
                    "fontSize": 6.5,
                    "fontWeight": "bold",
                    "color": "#167c80"
                  }
                },
                {
                  "type": "text",
                  "value": "123 Meridian Avenue · Bengaluru 560001 · +91 80 4567 8900",
                  "style": {
                    "fontSize": 6.5,
                    "color": "#526575"
                  }
                }
              ],
              "width": "*"
            },
            {
              "type": "image",
              "id": "hospital-right-seal",
              "src": "https://open-reports-demo.onrender.com/demo-videos/letterhead-assets/northstar-accreditation-mark.png",
              "width": 28,
              "height": 28,
              "fit": "contain",
              "alt": "Replaceable hospital accreditation seal"
            }
          ],
          "gap": 4,
          "alignItems": "center"
        },
        {
          "type": "line"
        },
        {
          "type": "text",
          "value": "LABORATORY REPORT",
          "style": {
            "fontSize": 8,
            "fontWeight": "bold",
            "color": "#526575"
          }
        }
      ]
    },
    {
      "type": "pageHeader",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "expression": "\"Patient: \" + data.report.patient.name + \" · UHID \" + data.report.patient.uhid",
              "width": "*",
              "style": {
                "fontSize": 7.5,
                "color": "#526575"
              }
            },
            {
              "type": "text",
              "value": "LABORATORY REPORT",
              "style": {
                "align": "right",
                "fontSize": 7.5,
                "fontWeight": "bold",
                "color": "#143753"
              }
            }
          ]
        },
        {
          "type": "line"
        }
      ]
    },
    {
      "type": "detail",
      "children": [
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "row",
          "children": [
            {
              "type": "column",
              "children": [
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "Patient",
                      "width": 70,
                      "style": {
                        "color": "#6b7280"
                      }
                    },
                    {
                      "type": "text",
                      "binding": "data.report.patient.name",
                      "style": {
                        "fontWeight": "bold"
                      }
                    }
                  ]
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "Age / Sex",
                      "width": 70,
                      "style": {
                        "color": "#6b7280"
                      }
                    },
                    {
                      "type": "text",
                      "expression": "data.report.patient.age + \" / \" + data.report.patient.sex"
                    }
                  ]
                }
              ],
              "width": "*"
            },
            {
              "type": "column",
              "children": [
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "UHID",
                      "width": 70,
                      "style": {
                        "color": "#6b7280"
                      }
                    },
                    {
                      "type": "text",
                      "binding": "data.report.patient.uhid"
                    }
                  ]
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "Consultant",
                      "width": 70,
                      "style": {
                        "color": "#6b7280"
                      }
                    },
                    {
                      "type": "text",
                      "binding": "data.report.patient.consultant"
                    }
                  ]
                }
              ],
              "width": "*"
            }
          ]
        },
        {
          "type": "spacer",
          "height": 10
        },
        {
          "type": "text",
          "binding": "data.report.test",
          "style": {
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "keepWithNext": true
        },
        {
          "type": "table",
          "id": "results",
          "dataset": "report.results",
          "minRowsAfterBreak": 2,
          "rowRules": [
            {
              "when": "row.value < row.low || row.value > row.high",
              "set": {
                "style.fontWeight": "bold",
                "style.color": "#b91c1c"
              }
            }
          ],
          "columns": [
            {
              "id": "parameter",
              "header": "Parameter",
              "binding": "row.parameter",
              "width": "*"
            },
            {
              "id": "value",
              "header": "Result",
              "binding": "row.value",
              "width": 70,
              "align": "right"
            },
            {
              "id": "unit",
              "header": "Unit",
              "binding": "row.unit",
              "width": 70
            },
            {
              "id": "range",
              "header": "Reference",
              "expression": "row.low + \" - \" + row.high",
              "width": 90
            },
            {
              "id": "flag",
              "header": "Flag",
              "expression": "row.value < row.low ? \"LOW\" : row.value > row.high ? \"HIGH\" : \"\"",
              "width": 50
            }
          ]
        },
        {
          "type": "spacer",
          "height": 10
        },
        {
          "type": "keepTogether",
          "children": [
            {
              "type": "text",
              "value": "Interpretation",
              "style": {
                "fontWeight": "bold"
              }
            },
            {
              "type": "text",
              "binding": "data.report.interpretation"
            }
          ]
        }
      ]
    },
    {
      "type": "pageFooter",
      "children": [
        {
          "type": "line"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "value": "Dr. Smith, MD Pathology · Sign and stamp",
              "width": "*",
              "style": {
                "fontSize": 7,
                "fontWeight": "bold",
                "color": "#526575"
              }
            },
            {
              "type": "text",
              "expression": "\"Page \" + page.number + \" of \" + page.total",
              "style": {
                "align": "right",
                "fontSize": 7,
                "color": "#526575"
              }
            }
          ]
        },
        {
          "type": "text",
          "value": "Confidential patient information · For care-team use",
          "style": {
            "fontSize": 6,
            "align": "center",
            "color": "#718096"
          }
        }
      ]
    }
  ]
}
